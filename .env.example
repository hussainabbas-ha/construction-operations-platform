# Construction operations / HeavyJob API
HCSS_CLIENT_ID=
HCSS_CLIENT_SECRET=
HCSS_SCOPE=heavyjob:read timecards:read
HCSS_TIMEOUT_SECONDS=120

# PostgreSQL
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app

# JWT
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=you@example.com
SMTP_PASSWORD=
EMAIL_RECIPIENTS=ops@example.com
SMTP_FROM_NAME=Construction Operations Bot
NOTIFY_SUPERVISOR_EMAIL=supervisor@example.com
NOTIFY_PM_EMAIL=pm@example.com
NOTIFY_ADMIN_EMAIL=admin@example.com
NOTIFY_EXTRA_EMAILS=ops@example.com
NOTIFY_TEST_EMAIL=ops@example.com
NOTIFY_ACCOUNTING_EMAIL=accounting@example.com

# API
LOG_FORMAT=text
LOG_LEVEL=INFO
ALLOWED_ORIGINS=*
DOCS_ENABLED=true

# Optional portal automation
HJ_PORTAL_USER=
HJ_PORTAL_PASS=
PORTAL_AUTOMATION_ENABLED=false
PORTAL_AUTOMATION_DRY_RUN=true
PORTAL_AUTOMATION_HEADED=false
PORTAL_AUTOMATION_RETRIES=2

# Optional Microsoft Graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=noreply@example.com
